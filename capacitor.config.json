{
  "appId": "com.blockblitz.app",
  "appName": "BlockBlitz",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#111633",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#111633",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": false,
      "backgroundColor": "#111633",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    }
  }
}
